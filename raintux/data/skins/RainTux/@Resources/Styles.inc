[StyleHeading]
FontFace=#FontFace#
FontSize=8
FontWeight=700
FontColor=#SubText#
StringCase=Upper
AntiAlias=1
InlineSetting=CharacterSpacing | 0 | 1.6

[StyleText]
FontFace=#FontFace#
FontSize=10
FontColor=#Text#
AntiAlias=1

[StyleValue]
FontFace=#FontFace#
FontSize=10
FontColor=#SubText#
StringAlign=Right
AntiAlias=1

[StyleBar]
BarOrientation=Horizontal
SolidColor=#Track#
BarColor=#Accent#,255
